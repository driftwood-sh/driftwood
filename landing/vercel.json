{
  "rewrites": [
    {
      "source": "/d/:slug*",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/d/:slug*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/auth/:path*"
    },
    {
      "source": "/health",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/health"
    },
    {
      "source": "/linkedin/:path*",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/linkedin/:path*"
    },
    {
      "source": "/email/:path*",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/email/:path*"
    },
    {
      "source": "/twitter/:path*",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/twitter/:path*"
    },
    {
      "source": "/mailboxes/:path*",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/mailboxes/:path*"
    },
    {
      "source": "/triage",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/triage"
    },
    {
      "source": "/triage/:path*",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/triage/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/api/:path*"
    },
    {
      "source": "/mcp/",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/mcp/"
    },
    {
      "source": "/mcp/:ppath(.*)",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/mcp/:ppath"
    },
    {
      "source": "/ingest/static/:ppath(.*)",
      "destination": "https://us-assets.i.posthog.com/static/:ppath"
    },
    {
      "source": "/ingest/:ppath(.*)",
      "destination": "https://us.i.posthog.com/:ppath"
    },
    {
      "source": "/dashboard/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/dashboard/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/dashboard.html"
    },
    {
      "source": "/((?!_vercel/|ingest/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/((?!d/|api/|auth/|health|linkedin/|email/|twitter/|mailboxes/|mcp/|triage|triage/|_vercel/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://app.cal.com https://api.switchfrog.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; font-src 'self'; connect-src 'self' https://storage.googleapis.com https://app.cal.com https://api.switchfrog.com; frame-src 'self' https://app.cal.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; media-src 'self' blob: https://storage.googleapis.com"
        }
      ]
    },
    {
      "source": "/asr/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/dashboard(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/og",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
